  (text "Nets:\nA0..3: 被乗数。A レジスタ（acc カード）の下位 4bit。U1・U2 の語 1（1A〜1D）へ\nB0..3: 乗数。B 入力選択（bsel カード）の下位 4bit。U1・U2 の語 2（2A〜2D）へ\nP0..7: 積（A0..3 × B0..3）。下位 4bit は U2、上位 4bit は U1 のオープンコレクタ出力で、RN1 でプルアップする。rsel カードの結果選択へ" (exclude_from_sim no) (at 12.7 177.8 0) (effects (font (face "Yu Gothic") (size 1.27 1.27)) (justify left top)) (uuid "c566b6f9-a81d-53dc-8cca-bd8bd22de3f5"))
  (sheet_instances (path "/" (page "1")))
